# Copy to .env for local dev. On Vercel, add these in Project Settings → Environment Variables.
# Apply them to Production, Preview, and Development.

# PostgreSQL connection string (Neon, Supabase, or another hosted Postgres).
# SQLite and a database running only on your laptop will not work on Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Gmail address and App Password used by /api/contact
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASS="your-gmail-app-password"

# Optional. Leave unset so the browser calls this site's own /api routes.
# NEXT_PUBLIC_API_URL="https://your-domain.com/api"

# Optional. PayPal client id. Defaults to the sandbox test client when unset.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
